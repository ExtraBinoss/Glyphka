{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glyphka-plinka",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "glyphka.plinka.eu",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
