    "clipper-lib": "^6.4.2",
    "cn": "^0.5.0",
    "i18next": "^26.4.7",
    "jotai": "^2.15.0",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.0.21",
    "shadcn": "^4.22.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0"
