{
  "name": "glyphka",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir artifacts/ssr && bun run scripts/prerender.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "bun run lint:oxlint && bun run lint:react",
    "test": "vitest run",
    "test:browser": "playwright test",
    "bench:engine": "bun run scripts/benchmark-engine.ts",
    "bench:shapes": "bun run scripts/benchmark-shapes.ts",
    "bench:browser": "bun run scripts/benchmark-browser.ts",
    "bench:hover": "bun run scripts/benchmark-hover.ts",
    "assets:social": "bun run scripts/render-social.ts && oxfmt artwork/social.html artwork/social/index.html",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build",
    "format": "oxfmt .",
    "deploy": "wrangler pages deploy dist --project-name glyphka-plinka --branch main",
    "lint:oxlint": "oxlint .",
    "lint:react": "eslint . --max-warnings 0",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "class-variance-authority": "^0.7.1",
    "clipper-lib": "^6.4.2",
    "cn": "^0.5.0",
    "culori": "^4.0.2",
    "d3-interpolate-path": "^2.3.0",
    "i18next": "^26.4.7",
    "jotai": "^2.15.0",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.0.21",
    "shadcn": "^4.22.0",
    "svgpath": "^2.6.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/clipper-lib": "^6.4.0",
    "@types/culori": "^4.0.1",
    "@types/d3-interpolate-path": "^2.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "8.3.4",
    "vitest": "^5.0.2",
    "wrangler": "4.151.1"
  }
}
