{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortImports": false,
  "sortTailwindcss": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "artifacts/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**",
    "worker-configuration.d.ts",
    "**/*.generated.*",
    "bun.lock",
    "**/*.md",
    "**/*.markdown",
    "**/*.mdx"
  ]
}
