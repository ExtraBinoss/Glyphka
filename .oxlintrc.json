{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "options": {
    "typeAware": true,
    "maxWarnings": 0,
    "respectEslintDisableDirectives": false,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "ignoreVoid": false
      }
    ],
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": {
          "attributes": false
        }
      }
    ],
    "eslint/eqeqeq": ["error", "smart"],
    "eslint/prefer-const": "error",
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "all",
        "caughtErrorsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "oxc/no-accumulating-spread": "error"
  },
  "overrides": [
    {
      "files": ["**/*.tsx"],
      "plugins": [
        "typescript",
        "unicorn",
        "oxc",
        "import",
        "react",
        "jsx-a11y"
      ],
      "rules": {
        // Official Hooks/Compiler analysis runs once, in lint:react.
        "react/rules-of-hooks": "off",
        "react/exhaustive-deps": "off",
        "react/jsx-key": "error",
        "react/jsx-no-duplicate-props": "error",
        "react/no-danger-with-children": "error",
        "jsx-a11y/alt-text": "error",
        "jsx-a11y/aria-props": "error",
        "jsx-a11y/aria-proptypes": "error",
        "jsx-a11y/aria-unsupported-elements": "error",
        "jsx-a11y/role-has-required-aria-props": "error",
        "jsx-a11y/role-supports-aria-props": "error",
        "jsx-a11y/anchor-has-content": "error",
        "jsx-a11y/anchor-is-valid": "error",
        "jsx-a11y/click-events-have-key-events": "error",
        "jsx-a11y/interactive-supports-focus": "error",
        "jsx-a11y/label-has-associated-control": "error",
        "jsx-a11y/tabindex-no-positive": "error",
        // SVG graphics and composite shadcn widgets require explicit ARIA roles.
        // Validate their ARIA, labels, focus and keyboard behavior separately.
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      "files": ["src/engine/{model,geometry,morph,randomize,variations}.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*",
                  "jotai",
                  "jotai/*",
                  "motion",
                  "motion/*",
                  "@/components/*",
                  "@/state/*"
                ],
                "message": "Keep geometry independent from React, UI state and animation adapters."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "artifacts/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**",
    "worker-configuration.d.ts",
    "**/*.generated.*"
  ]
}
